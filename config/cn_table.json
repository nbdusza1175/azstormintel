{
  "version": "3.1.0",
  "description": "SCS/NRCS curve numbers (AMC II) by NLCD class and hydrologic soil group [A,B,C,D]. Pervious CN only for developed classes; impervious fraction (NLCD) is blended at impervious_cn. Swap this file to change the loss parameterisation; no per-event tuning.",
  "sources": "NRCS TR-55 (1986) Tables 2-2a to 2-2d; NEH-630 Ch. 9; Williams (1995) slope adjustment; Hawkins/Chow AMC conversions",
  "impervious_cn": 98,
  "ia_ratio": 0.2,
  "cn_bounds": [
    30,
    99
  ],
  "dual_hsg_use": "undrained",
  "slope_adjustment": {
    "enabled": false,
    "method": "Williams 1995: CN2s = (CN3-CN2)/3*(1-2exp(-13.86 S)) + CN2",
    "increase_only": true,
    "max_slope": 1.0,
    "note": "Off by default in v3.1: Williams (1995) was derived for agricultural SWAT HRUs and added ~3-5 CN on steep forest."
  },
  "amc": {
    "I": "CN1 = 4.2 CN2 / (10 - 0.058 CN2)",
    "III": "CN3 = 23 CN2 / (10 + 0.13 CN2)"
  },
